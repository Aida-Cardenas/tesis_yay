<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="bumperbot">

    <ros2_control name="RobotSystem" type="system">

        <!-- ros2_control Gazebo -->
        <xacro:if value="$(arg is_sim)">
            <!-- ROS 2 Humble -->
            <xacro:if value="$(arg is_ignition)">
                <hardware>
                    <plugin>ign_ros2_control/IgnitionSystem</plugin>
                </hardware>
            </xacro:if>

            <!-- ROS 2 Iron or above -->
            <xacro:unless value="$(arg is_ignition)">
                <hardware>
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </hardware>
            </xacro:unless>
        </xacro:if>

        <!-- ros2_control Real Robot -->
        <xacro:unless value="$(arg is_sim)">
            <xacro:if value="$(arg use_mock_hardware)">
                <hardware>
                    <plugin>mock_components/GenericSystem</plugin>
                    <param name="calculate_dynamics">true</param>
                </hardware>
            </xacro:if>
            <xacro:unless value="$(arg use_mock_hardware)">
                <hardware>
                    <plugin>bumperbot_firmware/BumperbotInterface</plugin>
                    <param name="port">$(arg arduino_port)</param>
                    <!-- Must match counts_per_rev in robot_control.ino -->
                    <param name="encoder_counts_per_rev">770</param>
                </hardware>
            </xacro:unless>
        </xacro:unless>
        
        <!-- ros2_control Common Interfaces.
             Wheel limits in rad/s: 0.7 m/s (the controller limit) / 0.033 m = 21 rad/s.
             The JGA25-370 at 12 V reaches about 17.8 rad/s (170 RPM). -->
        <joint name="wheel_left_joint">
            <command_interface name="velocity">
              <param name="min">-21</param>
              <param name="max">21</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <joint name="wheel_right_joint">
            <command_interface name="velocity">
              <param name="min">-21</param>
              <param name="max">21</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        
    </ros2_control>

</robot>