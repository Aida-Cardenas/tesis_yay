Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: Gemelo (modelo)
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR del gemelo
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Size (m): 0.03
      Color Transformer: FlatColor
      Color: 0; 170; 255
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Trayectoria robot real
      Enabled: true
      Topic:
        Value: /digital_twin/real_path
      Color: 230; 60; 60
      Line Style: Billboards
      Line Width: 0.02
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Trayectoria gemelo
      Enabled: true
      Topic:
        Value: /digital_twin/twin_path
      Color: 40; 120; 230
      Line Style: Billboards
      Line Width: 0.02
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: Pose robot real
      Enabled: true
      Topic:
        Value: /digital_twin/real_pose
      Shape: Arrow
      Color: 230; 60; 60
      Shaft Length: 0.2
      Head Length: 0.08
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: Pose gemelo
      Enabled: true
      Topic:
        Value: /digital_twin/twin_pose
      Shape: Arrow
      Color: 40; 120; 230
      Shaft Length: 0.2
      Head Length: 0.08
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Value: false
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 120
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
